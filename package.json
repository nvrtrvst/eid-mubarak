{
  "name": "eid",
  "version": "1.0.0",
  "description": "Optimized Eid celebration website with Three.js 3D animations",
  "main": "index.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./css/output.css --minify",
    "build:css-dev": "tailwindcss -i ./src/input.css -o ./css/output.css --watch",
    "optimize:css": "postcss ./css/output.css -o ./css/output.min.css",
    "build": "npm run build:css && vite build",
    "dev": "npm run build:css-dev & vite",
    "preview": "vite preview",
    "analyze": "npm run build && echo 'Build analysis complete. Check dist/ directory for optimized assets.'",
    "serve:optimized": "npx serve dist -s",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": ["performance", "optimization", "threejs", "webgl", "eid", "tailwindcss"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "tailwindcss": "^3.0.24",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^0.1.2",
    "@vitejs/plugin-legacy": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "cssnano": "^7.0.7",
    "postcss-cli": "^11.0.0",
    "terser": "^5.38.0",
    "vite": "^7.0.6",
    "vite-bundle-analyzer": "^0.18.0"
  }
}
